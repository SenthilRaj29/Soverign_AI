# Sovereign On-Premise Agentic AI Workbench - Environment Configuration

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=sovereign_secret_key_change_in_production_32bytes_min

# Core Sovereignty Policy
EXTERNAL_NETWORK_ENABLED=false

# Local LLM & Ollama Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:latest
OLLAMA_VISION_MODEL=gemma3:latest
OLLAMA_TIMEOUT=120

# Local Embedding Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# Local Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=sovereign_knowledge

# PostgreSQL Database
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=sovereign_pass
POSTGRES_DB=sovereign_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sovereign:sovereign_pass@localhost:5432/sovereign_db

# Local Document & Artifact Storage
STORAGE_BASE_PATH=./knowledge_base
ARTIFACTS_STORAGE_PATH=./reports/generated

# OCR Service Configuration
OCR_ENGINE=paddleocr
OCR_LANG=en

# Security & Sandboxing
SANDBOX_ENABLED=true
SANDBOX_DOCKER_IMAGE=sovereign-python-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0

# Monitoring
PROMETHEUS_METRICS_ENABLED=true
